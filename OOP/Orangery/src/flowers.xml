<?xml version="1.0" encoding="UTF-8"?>
<tns:Greenhouse xmlns:tns="flowers.xsd"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="flowers.xsd Flowers.xsd">

    <Flower id="f1">
        <Name>Троянда</Name>
        <Soil>ґрунтовий</Soil>
        <Origin>Китай</Origin>
        <VisualParameters>
            <StemColor>зелений</StemColor>
            <LeafColor>темно-зелений</LeafColor>
            <AverageSize unit="cm">70.5</AverageSize>
        </VisualParameters>
        <GrowingTips>
            <Temperature unit="celsius">22</Temperature>
            <Lighting lightRequiring="true"/>
            <Watering unit="ml_per_week">500</Watering>
        </GrowingTips>
        <Multiplying>живцями</Multiplying>
    </Flower>

    <Flower id="f2">
        <Name>Фіалка</Name>
        <Soil>підзолистий</Soil>
        <Origin>Африка</Origin>
        <VisualParameters>
            <StemColor>коричневий</StemColor>
            <LeafColor>зелений</LeafColor>
            <AverageSize unit="cm">15.0</AverageSize>
        </VisualParameters>
        <GrowingTips>
            <Temperature unit="celsius">18</Temperature>
            <Lighting lightRequiring="false"/>
            <Watering unit="ml_per_week">300</Watering>
        </GrowingTips>
        <Multiplying>листям</Multiplying>
    </Flower>

    <Flower id="f3">
        <Name>Кактус</Name>
        <Soil>дерново-підзолистий</Soil>
        <Origin>Америка</Origin>
        <VisualParameters>
            <StemColor>зелений</StemColor>
            <LeafColor>немає</LeafColor> <AverageSize unit="cm">25.0</AverageSize>
        </VisualParameters>
        <GrowingTips>
            <Temperature unit="celsius">25</Temperature>
            <Lighting lightRequiring="true"/>
            <Watering unit="ml_per_week">50</Watering>
        </GrowingTips>
        <Multiplying>насінням</Multiplying>
    </Flower>

    <Flower id="f4">
        <Name>Орхідея</Name>
        <Soil>ґрунтовий</Soil>
        <Origin>Азія</Origin>
        <VisualParameters>
            <StemColor>зелений</StemColor>
            <LeafColor>яскраво-зелений</LeafColor>
            <AverageSize unit="cm">40.0</AverageSize>
        </VisualParameters>
        <GrowingTips>
            <Temperature unit="celsius">24</Temperature>
            <Lighting lightRequiring="true"/>
            <Watering unit="ml_per_week">200</Watering>
        </GrowingTips>
        <Multiplying>живцями</Multiplying>
    </Flower>

</tns:Greenhouse>